---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
	title?: string;
	description?: string;
}
const { title = '页面', description = '' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<div class="layout-grid page-grid">
			<main class="card-base page-main">
				<h1>{title}</h1>
				<article class="content">
					<slot />
				</article>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
<style>
	.page-grid {
		padding-top: calc(var(--navbar-h) + 1.5rem);
	}
	.page-main {
		padding: 1.6rem 1.8rem;
	}
	.page-main h1 {
		margin-top: 0;
	}
	.content {
		line-height: 1.9;
	}
</style>