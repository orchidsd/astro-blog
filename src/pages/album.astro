---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import album from '../data/album.json';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`相册 - ${SITE_TITLE}`} description="相册收藏" />
	</head>
	<body>
		<Header />
		<div class="layout-grid page-grid">
			<main class="card-base page-main album">
				<h1>相册</h1>
				<ul class="grid">
					{album.map((a) => (
						<li class="card">
							<a href={a.path_name}>
								<img src={a.cover} alt={a.class_name} loading="lazy" />
								<span class="info">
									<span class="name">{a.class_name}</span>
									<span class="descr">{a.description}</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
<style>
	.album {
		width: 100%;
	}
	.grid {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1em;
	}
	.card {
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
		overflow: hidden;
		background: var(--card-bg);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		border-color: oklch(0.78 0.14 var(--hue));
	}
	.card img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
	}
	.card .info {
		display: block;
		padding: 0.7em 0.9em;
	}
	.name {
		font-weight: 600;
	}
	.descr {
		display: block;
		font-size: 0.82em;
		color: var(--content-meta);
		margin-top: 0.2em;
	}
</style>