---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../../components/BaseHead.astro';
import Footer from '../../../../components/Footer.astro';
import Header from '../../../../components/Header.astro';
import Sidebar from '../../../../components/Sidebar.astro';
import { postPathParts, taxSlug } from '../../../../lib/posts';

type Post = CollectionEntry<'blog'>;

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: postPathParts(post),
		props: { post },
	}));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { year, month, day, slug } = postPathParts(post);
const all = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const idx = all.findIndex((p) => p.id === post.id);
const prev = all[idx + 1];
const next = all[idx - 1] ?? undefined;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={post.data.title} description={post.data.description} />
	</head>
	<body>
		<Header />
		<div class="layout-grid page-grid">
			<main class="card-base page-main post-main">
				<article>
					<header class="post-head">
						<h1>{post.data.title}</h1>
						<div class="post-meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{year}-{month}-{day}
							</time>
							{post.data.categories?.length > 0 && (
								<span>
									{post.data.categories.map((c) => (
										<a href={`/categories/${taxSlug(c)}/`}>{c}</a>
									))}
								</span>
							)}
						</div>
					</header>
					<div class="prose">
						<Content />
					</div>
					<nav class="pager">
						{prev && (
							<a class="prev" href={`/${postPathParts(prev).year}/${postPathParts(prev).month}/${postPathParts(prev).day}/${prev.id.replace(/\.md$/, '')}/`}>
								← {prev.data.title}
							</a>
						)}
						{next && (
							<a
								class="next"
								href={`/${postPathParts(next).year}/${postPathParts(next).month}/${postPathParts(next).day}/${next.id.replace(/\.md$/, '')}/`}
							>
								{next.data.title} →
							</a>
						)}
					</nav>
				</article>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
<style>
	.post-head {
		margin-bottom: 1.5em;
		padding-bottom: 1em;
		border-bottom: 1px solid var(--line-divider);
	}
	.post-head h1 {
		margin: 0 0 0.5em;
		font-size: 1.8em;
	}
	.post-meta {
		color: var(--content-meta);
		font-size: 0.9em;
		display: flex;
		gap: 1.5em;
	}
	.post-meta a {
		margin-right: 0.5em;
	}
	.prose {
		line-height: 1.9;
	}
	.prose :global(h2),
	.prose :global(h3) {
		position: relative;
		padding-left: 0.6em;
	}
	.prose :global(h2)::before,
	.prose :global(h3)::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.35em;
		bottom: 0.35em;
		width: 4px;
		border-radius: 2px;
		background: var(--primary);
	}
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		margin-top: 3em;
		padding-top: 1em;
		border-top: 1px solid var(--line-divider);
		font-size: 0.9em;
	}
	.pager a {
		max-width: 45%;
	}
	.next {
		margin-left: auto;
	}
</style>