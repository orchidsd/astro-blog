---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import essay from '../data/essay.json';
import { SITE_TITLE } from '../consts';

const d = essay[0] as any;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${d.title} - ${SITE_TITLE}`} description={d.subTitle} />
	</head>
	<body>
		<Header />
		<div class="layout-grid page-grid">
			<main class="card-base page-main essay">
				<h1>{d.title}</h1>
				<p class="sub">{d.subTitle}</p>
				<ul class="list">
					{d.essay_list.map((item: any) => (
						<li>
							{item.link ? (
								<a href={item.link} target="_blank" rel="noopener">
									{item.content}
								</a>
							) : (
								<span>{item.content}</span>
							)}
							<span class="date">{item.date}</span>
						</li>
					))}
				</ul>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
<style>
	.essay {
		width: 100%;
	}
	.sub {
		color: var(--content-meta);
	}
	.list {
		list-style: none;
		padding: 0;
	}
	.list li {
		padding: 0.9em 0;
		border-bottom: 1px dashed var(--line-divider);
		display: flex;
		justify-content: space-between;
		gap: 1em;
		align-items: baseline;
	}
	.date {
		color: var(--content-meta);
		font-size: 0.85em;
		white-space: nowrap;
	}
</style>