---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const topPosts = posts.filter((p) => p.data.top > 0).sort((a, b) => b.data.top - a.data.top);
const featured = topPosts.length ? topPosts : posts.slice(0, 10);
const recent = posts.filter((p) => !featured.includes(p)).slice(0, 9);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="site-title">{SITE_TITLE}</h1>
			<p class="site-desc">{SITE_DESCRIPTION}</p>
			<section>
				{featured.map((p) => <PostCard post={p} />)}
			</section>
			<h2 class="sec-title">最新发布</h2>
			<section class="grid">
				{recent.map((p) => <PostCard post={p} />)}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.site-title {
		text-align: center;
		margin-bottom: 0.2em;
	}
	.site-desc {
		text-align: center;
		color: rgb(var(--gray));
		margin-bottom: 2em;
	}
	.sec-title {
		margin-top: 3em;
	}
	.grid {
		columns: 2;
		column-gap: 1.5em;
	}
	.grid :global(.card) {
		break-inside: avoid;
	}
	@media (max-width: 760px) {
		.grid {
			columns: 1;
		}
	}
</style>