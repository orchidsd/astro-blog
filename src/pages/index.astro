---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const topPosts = posts.filter((p) => p.data.top > 0).sort((a, b) => b.data.top - a.data.top);
const featured = topPosts.length ? topPosts : posts.slice(0, 10);
const recent = posts.filter((p) => !featured.includes(p)).slice(0, 9);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="banner-wrap">
			<div class="banner-inner">
				<h1 class="banner-title">{SITE_TITLE}</h1>
				<p class="banner-subtitle">{SITE_DESCRIPTION}</p>
			</div>
		</div>
		<div class="layout-grid">
			<main class="main-col">
				<section class="main-cards">
					{featured.map((p) => <PostCard post={p} />)}
				</section>
				<h2 class="sec-title">最新发布</h2>
				<section class="main-cards">
					{recent.map((p) => <PostCard post={p} />)}
				</section>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
<style>
	.banner-wrap {
		min-height: var(--banner-height-home);
		margin-bottom: -2.5rem;
	}
	.banner-title {
		animation-duration: 0.4s;
	}
	@media (max-width: 640px) {
		.banner-wrap {
			min-height: 70vh;
			min-height: 450px;
		}
	}
</style>