---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE } from '../../consts';
import { postHref } from '../../lib/posts';

export async function getStaticPaths() {
	const all = await getCollection('blog');
	const cats = new Set<string>();
	for (const p of all) for (const c of p.data.categories ?? []) cats.add(c);
	return [...cats].map((c) => ({ params: { category: c }, props: { cat: c } }));
}

const { cat } = Astro.props;
const posts = (await getCollection('blog')).filter((p) =>
	(p.data.categories ?? []).includes(cat),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${cat} - ${SITE_TITLE}`} description={`分类：${cat}`} />
	</head>
	<body>
		<Header />
		<div class="layout-grid page-grid">
			<main class="card-base page-main">
				<h1>分类：{cat}</h1>
				<p class="count">共 {posts.length} 篇</p>
				<ul class="post-list">
					{posts
						.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
						.map((p) => (
							<li>
								<a href={postHref(p)}>{p.data.title}</a>
								<span class="date">
									{p.data.pubDate.toLocaleDateString('zh-CN')}
								</span>
							</li>
						))}
				</ul>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
<style>
	.count {
		color: var(--content-meta);
	}
	.post-list {
		list-style: none;
		padding: 0;
	}
	.post-list li {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		padding: 0.4em 0;
		border-bottom: 1px dashed var(--line-divider);
	}
	.date {
		color: var(--content-meta);
		font-size: 0.85em;
		white-space: nowrap;
	}
</style>