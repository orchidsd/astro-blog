---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const cats = new Map<string, number>();
for (const p of posts) for (const c of p.data.categories ?? []) cats.set(c, (cats.get(c) ?? 0) + 1);
const list = [...cats.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`分类 - ${SITE_TITLE}`} description="文章分类" />
	</head>
	<body>
		<Header />
		<div class="layout-grid page-grid">
			<main class="card-base page-main">
				<h1>分类</h1>
				<ul class="tags">
					{list.map(([c, n]) => (
						<li>
							<a href={`/categories/${c}/`}>{c}</a>
							<span class="count">{n}</span>
						</li>
					))}
				</ul>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
<style>
	.tags {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}
	.tags li {
		background: var(--line-divider);
		padding: 0.5em 0.9em;
		border-radius: var(--radius);
		font-size: 0.9em;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.count {
		color: var(--content-meta);
		font-size: 0.85em;
	}
</style>