---
import type { Post } from '../lib/posts';
import { postHref, taxSlug } from '../lib/posts';
const { post } = Astro.props as { post: Post };
const cover = post.data.heroImage ?? '';
const pinned = (post.data.top ?? 0) > 0;
---

<article class:list={['card-base', 'post-card', { 'has-cover': !!cover, pinned }]}>
	{cover && (
		<a class="post-cover" href={postHref(post)}>
			<img src={cover} alt="" loading="lazy" />
		</a>
	)}
	<div class="post-body">
		<h3>
			<a href={postHref(post)}>{post.data.title}</a>
		</h3>
		<div class="post-meta">
			{pinned && <span class="pin-badge">置顶</span>}
			<time datetime={post.data.pubDate.toISOString()}>
				{post.data.pubDate.toLocaleDateString('zh-CN')}
			</time>
			<span class="post-cats">
				{post.data.categories?.map((c) => <a href={`/categories/${taxSlug(c)}/`}>{c}</a>)}
			</span>
		</div>
		{post.data.description && <p class="post-desc">{post.data.description}</p>}
	</div>
</article>