---
const today = new Date();
const nav = [
	{ label: '首页', href: '/' },
	{ label: '归档', href: '/archives/' },
	{ label: '分类', href: '/categories/' },
	{ label: '标签', href: '/tags/' },
	{ label: '搜索', href: '/search/' },
];
const pages = [
	{ label: '关于', href: '/about/' },
	{ label: '相册', href: '/album/' },
	{ label: '朋友圈', href: '/fcircle/' },
	{ label: '友链', href: '/link/' },
	{ label: '音乐', href: '/music/' },
	{ label: '即刻短文', href: '/essay/' },
	{ label: '隐私', href: '/privacy/' },
	{ label: '版权', href: '/copyright/' },
	{ label: 'Cookie', href: '/cookies/' },
];
---

<footer class="footer">
	<nav class="links" aria-label="页脚导航">
		<div class="col">
			<h4>站点</h4>
			<ul>
				{nav.map((n) => (
					<li>
						<a href={n.href}>{n.label}</a>
					</li>
				))}
			</ul>
		</div>
		<div class="col">
			<h4>页面</h4>
			<ul>
				{pages.map((p) => (
					<li>
						<a href={p.href}>{p.label}</a>
					</li>
				))}
			</ul>
		</div>
	</nav>
	<p class="copy">
		&copy; {today.getFullYear()} Yoki · <a href="/rss.xml">RSS</a>
	</p>
</footer>
<style>
	.footer {
		padding: 3em 1em 2em;
		margin-top: 4em;
		border-top: 1px solid var(--line-divider);
		color: var(--content-meta);
		font-size: 0.9em;
	}
	.links {
		max-width: 900px;
		margin: 0 auto;
		display: flex;
		gap: 3em;
		justify-content: center;
		flex-wrap: wrap;
	}
	.col h4 {
		margin: 0 0 0.6em;
		color: var(--deep-text);
	}
	.col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2;
		column-gap: 1.5em;
	}
	.col li {
		line-height: 1.9;
	}
	.copy {
		text-align: center;
		margin-top: 2em;
	}
</style>